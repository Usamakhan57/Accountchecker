# Frontend configuration.
#
# Everything here is PUBLIC. Vite inlines VITE_* values into the built
# JavaScript, so anyone can read them. API keys, database credentials and
# secrets of any kind belong in the backend .env and never in this file.

# Where the API lives. Leave it empty in production: Nginx serves the app and
# the API from one origin, so /api is already same-origin, which is what keeps
# the SameSite=Lax session cookie working.
VITE_API_URL=

# Dev server only. The dev server proxies /api to this address so development
# behaves like production and needs no CORS. It is not part of the build.
VITE_DEV_API_PROXY=http://127.0.0.1:8080

VITE_APP_NAME=AccountCheck
