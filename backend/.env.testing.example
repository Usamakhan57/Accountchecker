# Test environment for PHPUnit. Copy to backend/.env.testing.
#
# Database-backed tests run against this database and TRUNCATE tables between
# cases, so it must be a dedicated database — never the development one.
# Leave DB_NAME blank to skip those tests; the rest of the suite still runs.

APP_ENV=testing
APP_DEBUG=true
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=accountcheck_test
DB_USER=accountcheck_app
DB_PASSWORD=

CHECKER_MODE=mock
MAIL_DRIVER=log
LOG_LEVEL=error
