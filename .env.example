# ---------------------------------------------------------------------------
# AccountCheck - backend environment template
#
# Copy to backend/.env and fill in real values. NEVER commit a populated .env.
# Values here are placeholders only; no real secret belongs in this file.
# ---------------------------------------------------------------------------

# Application -----------------------------------------------------------------
APP_NAME=AccountCheck
APP_ENV=development            # development | production
APP_DEBUG=true                 # must be false in production
APP_URL=http://localhost:8080  # public URL of the PHP API
APP_KEY=                       # 32+ random bytes, base64; generate per install
APP_TIMEZONE=UTC

# Frontend origin allowed by CORS. Comma-separated. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database --------------------------------------------------------------------
# Use a dedicated application user. Never the MySQL root account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=accountcheck
DB_USER=accountcheck_app
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sessions --------------------------------------------------------------------
SESSION_COOKIE_NAME=accountcheck_session
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_COOKIE_SECURE=false    # true whenever the API is served over HTTPS
SESSION_COOKIE_SAMESITE=Lax    # Lax same-site, None for cross-site + Secure
SESSION_COOKIE_DOMAIN=

# Checker engine --------------------------------------------------------------
# mock       - deterministic local results, no outbound calls (development/tests)
# production - requires authorized provider credentials below
CHECKER_MODE=mock
CHECKER_HTTP_TIMEOUT=15
CHECKER_MAX_RETRIES=3
CHECKER_RETRY_BASE_DELAY_MS=500

# Authorized verification providers. Leave blank to report UNAVAILABLE.
GMAIL_VERIFY_API_URL=
GMAIL_VERIFY_API_KEY=
INSTAGRAM_VERIFY_API_URL=
INSTAGRAM_VERIFY_API_KEY=
FACEBOOK_VERIFY_API_URL=
FACEBOOK_VERIFY_API_KEY=
X_VERIFY_API_URL=
X_VERIFY_API_KEY=
TIKTOK_VERIFY_API_URL=
TIKTOK_VERIFY_API_KEY=
THREADS_VERIFY_API_URL=
THREADS_VERIFY_API_KEY=

# Queue / worker --------------------------------------------------------------
QUEUE_BATCH_SIZE=50
QUEUE_MAX_JOB_ITEMS=5000
QUEUE_INSERT_CHUNK_SIZE=500
QUEUE_MAX_ITEM_ATTEMPTS=3
QUEUE_MAX_ACTIVE_JOBS_PER_USER=3
WORKER_SLEEP_SECONDS=3
# A worker's claim is a lease. Anything held longer than this is assumed to
# belong to a process that died and is returned to the queue.
WORKER_LOCK_TTL_SECONDS=300
WORKER_MAX_RUNTIME_SECONDS=3600

# Free tools ------------------------------------------------------------------
# The duplicate finder and name generator cost no credits and start no job.
TOOLS_MAX_LINES=20000

# Uploads ---------------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880       # 5 MB
UPLOAD_ALLOWED_EXTENSIONS=txt,csv

# Exports ---------------------------------------------------------------------
EXPORT_RETENTION_HOURS=48
EXPORT_MAX_PER_HOUR=20

# Rate limiting ---------------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_API_REQUESTS=300
RATE_LIMIT_API_WINDOW_MINUTES=1

# Mail ------------------------------------------------------------------------
MAIL_DRIVER=log                # log | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=AccountCheck

# Logging ---------------------------------------------------------------------
LOG_LEVEL=debug                # debug | info | warning | error
